ENVIRONMENT=development

# Ports match docker-compose.yml's local dev mapping (5434/6380) — this
# machine already has native Postgres/Redis services on the standard ports.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/agent_firewall
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Gmail API (OAuth, send-only scope) — never commit real values
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# Stripe — test mode keys only
STRIPE_SECRET_KEY=

CORS_ORIGINS=["http://localhost:3000"]
