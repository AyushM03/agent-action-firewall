ENVIRONMENT=development

# Ports match docker-compose.yml's local dev mapping (5434/6380) — this
# machine already has native Postgres/Redis services on the standard ports.
# The backend connects as a least-privilege login in the `aaf_app` role: it can append
# to the audit log but not edit, delete or truncate it, or disable its triggers.
# After `alembic upgrade head`, create the login once (pick your own password):
#   docker compose exec postgres psql -U postgres -d agent_firewall #     -c "CREATE ROLE aaf_backend LOGIN PASSWORD 'change-me' IN ROLE aaf_app;"
DATABASE_URL=postgresql+asyncpg://aaf_backend:change-me@localhost:5434/agent_firewall
# Table owner, used only by Alembic and the DB-layer tests.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/agent_firewall
# Log every SQL statement (debugging only; parameters are never logged).
DB_ECHO=false
REDIS_URL=redis://localhost:6380/0

# At least 32 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Outside ENVIRONMENT=development the app refuses to start with a weak secret or a
# superuser/owner DATABASE_URL.
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Gmail API (OAuth, send-only scope) — never commit real values.
# Create a "Desktop app" OAuth client in Google Cloud with the Gmail API enabled,
# fill in the ID/secret, then run `python -m app.manage gmail-auth` for the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail account that granted consent; used as the From address.
GMAIL_SENDER_ADDRESS=

# Stripe — test mode keys only (sk_test_... / rk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=

CORS_ORIGINS=["http://localhost:3000"]
